 client.on(Events.InteractionCreate, async interaction => {
+  // Button interactions (vote panel)
+  if (interaction.isButton()) {
+    if (!isAuthorized(interaction)) {
+      return interaction.reply({
+        content: ' You do not have the **kraken** role required to use this.',
+        flags: MessageFlags.Ephemeral
+      });
+    }
+
+    try {
+      const id = String(interaction.customId || '');
+      if (!id.startsWith('kv:')) return; // ignore non-kraken buttons
+
+      // Format: kv:<snapshotId>:<action>
+      const parts = id.split(':');
+      const snapshotId = parts[1];
+      const action = parts[2];
+
+      const guildId = interaction.guildId;
+      if (!guildId) {
+        return interaction.reply({ content: ' This action is only available in a server.', flags: MessageFlags.Ephemeral });
+      }
+
+      const v = getVote(guildId, snapshotId);
+      if (!v) {
+        return interaction.reply({ content: ' Vote is not open (or it expired). Run `/recent` to open todays vote panel again.', flags: MessageFlags.Ephemeral });
+      }
+
+      if (action === 'STATUS') {
+        const t = tally(v);
+        const d = decide(t);
+        const lines = [];
+        lines.push(`Votes: **${t.total}**`);
+        lines.push(`Kick All: **${t.kickAll}**`);
+        lines.push(`No Action: **${t.noAction}**`);
+        lines.push(`Kick One: ${t.kickOne.map((n, i) => `#${i + 1}=${n}`).join('  ')}`);
+        lines.push('Result: **' + d.status + '**  ' + (d.reason || ''));
+        return interaction.reply({ content: lines.join('\n'), flags: MessageFlags.Ephemeral });
+      }
+
+      if (action === 'KA') {
+        castVote(guildId, snapshotId, interaction.user.id, { type: 'KICK_ALL' });
+        return interaction.reply({ content: ' Vote recorded: **Kick All (bottom 5)**', flags: MessageFlags.Ephemeral });
+      }
+      if (action === 'NA') {
+        castVote(guildId, snapshotId, interaction.user.id, { type: 'NO_ACTION' });
+        return interaction.reply({ content: ' Vote recorded: **No Action**', flags: MessageFlags.Ephemeral });
+      }
+      if (action && action.startsWith('K1')) {
+        const idx = Number(action.replace('K1', ''));
+        if (!Number.isInteger(idx) || idx < 1 || idx > 5) {
+          return interaction.reply({ content: ' Invalid option.', flags: MessageFlags.Ephemeral });
+        }
+        castVote(guildId, snapshotId, interaction.user.id, { type: 'KICK_ONE', index: idx - 1 });
+        const target = v.bottomFive?.[idx - 1]?.name || `#${idx}`;
+        return interaction.reply({ content: ` Vote recorded: **Kick One**  ${target}`, flags: MessageFlags.Ephemeral });
+      }
+
+      return interaction.reply({ content: ' Unknown action.', flags: MessageFlags.Ephemeral });
+    } catch {
+      return interaction.reply({ content: ' Could not record vote right now. Try again.', flags: MessageFlags.Ephemeral });
+    }
+  }
