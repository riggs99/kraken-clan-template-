+function snapshotIdFrom(meta, dayKey) {
+  const date = new Date().toISOString().slice(0, 10);
+  const safeDay = String(dayKey || '').replace(':', '-');
+  const rk = meta && meta.periodIndex !== undefined ? String(meta.periodIndex) : '';
+  return `${rk}_${safeDay}_${date}`;
+}
+
+function sortByDesc(list, key) {
+  return list.slice().sort((a, b) => Number(b[key] || 0) - Number(a[key] || 0));
+}
+
+function formatList(items, fmt, empty = 'No data') {
+  if (!items || !items.length) return empty;
+  return items.map(fmt).join('\n');
+}
