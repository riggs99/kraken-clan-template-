# KRAKEN ENV TEMPLATE (NO SECRETS)
# Copy to .env and fill values:
#   Copy-Item .env.example .env

# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
LEADER_CHANNEL_ID=
# Optional — falls back to LEADER_CHANNEL_ID if unset. A separate channel for
# scheduled daily/weekly reports, if you want them somewhere other than the
# leader channel.
REPORTS_CHANNEL_ID=

# Access control (comma-separated role IDs)
ALLOWED_ROLE_IDS=

# Clash Royale API (RoyaleAPI proxy recommended)
CR_API_BASE=https://proxy.royaleapi.dev
CR_API_TOKEN=

# Clan (without #)
CLAN_TAG=

# Where kraken.db lives. Defaults to <project folder>/data/kraken.db if unset
# — only set this if you need the database somewhere else.
KRAKEN_DB_PATH=

# Optional: Circuit breaker tuning
CR_BREAKER_WINDOW_MS=60000
CR_BREAKER_THRESHOLD=5
CR_BREAKER_OPEN_MS=600000

# Optional — a clan-badge/logo image URL shown in dashboard headers. Leave
# unset for no image.
CLAN_BADGE_URL=

# Optional — days a member must miss to trigger the "at risk" grace window.
# Defaults to 1 if unset.
GRACE_DAYS=

# Optional — override the fallback war-day-classification anchor date (see
# src/war-cycle.js's comment on DEFAULT_WAR_ANCHOR_UTC for what this is and
# why you likely don't need to touch it). ISO 8601 UTC timestamp, or set
# RECRUIT_WAR_ANCHOR_EPOCH_MS instead with a raw epoch-ms value.
RECRUIT_WAR_ANCHOR_UTC=
RECRUIT_WAR_ANCHOR_EPOCH_MS=

# Optional — overrides config/recruit.config.json's channels.feedbackChannelId
# for where the "report a bug" prompt in the welcome guide points.
RECRUIT_FEEDBACK_CHANNEL_ID=

# Optional — how many days of history the startup backfill audit reports on
# after downtime. Defaults to 1 if unset; set to 0 to disable it entirely.
RECRUIT_STARTUP_BACKFILL_DAYS=

# Optional — max characters per line before /ops truncates a table row.
# Defaults to a sane value if unset; only worth touching if tables look cut
# off or too sparse on your Discord client.
OPS_MAX_LINE_CHARS=

# Dev/test only — do not set this in a real deployment. Disables the 24h
# re-apply cooldown so you can repeatedly test /apply without waiting.
RECRUIT_DISABLE_COOLDOWNS=

# Dev/test only — logs full CR API response bodies on error. Can leak data
# into logs; leave unset in a real deployment.
DEBUG_CR_API_BODY=
